---
layout: base.njk
---
{% set headings = content | toc %}
<article class="essay">
  <header class="essay-head">
    <span class="stamp">Issued {{ page.date | isoDate }}</span>
  </header>
  {% if headings.length %}
  <details class="toc-inline">
    <summary>On this sheet</summary>
    <ol>
      {% for h in headings %}
      <li><a href="#{{ h.id }}">{{ h.text }}</a></li>
      {% endfor %}
    </ol>
  </details>
  {% endif %}
  <div class="essay-layout">
    <div class="prose">
{{ content | safe }}
    </div>
    {% if headings.length %}
    <aside class="toc">
      <nav aria-label="On this sheet">
        <span class="toc-title">On this sheet</span>
        <ol>
          {% for h in headings %}
          <li><a href="#{{ h.id }}">{{ h.text }}</a></li>
          {% endfor %}
        </ol>
      </nav>
    </aside>
    {% endif %}
  </div>
</article>
